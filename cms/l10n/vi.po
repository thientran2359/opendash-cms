#: server:error:redirects.empty_source_path
msgid "Source path must not be empty."
msgstr "Đường dẫn nguồn không được để trống."

#: server:error:redirects.source_path_too_long
msgid "Source path exceeds the 512-byte limit."
msgstr "Đường dẫn nguồn vượt quá giới hạn 512 byte."

#: server:error:redirects.source_path_invalid_format
msgid "Source path must start with '/', cannot be '/', and must not contain spaces, '?', '#', '\\', or empty/'.'/'..' segments."
msgstr "Đường dẫn nguồn phải bắt đầu bằng '/', không phải '/', và không chứa khoảng trắng, '?', '#', '\\' hoặc đoạn rỗng/'.'/'..'."

#: server:error:redirects.source_path_reserved_root
msgid "Source path collides with a reserved system prefix."
msgstr "Đường dẫn nguồn trùng với tiền tố hệ thống được bảo vệ."

#: server:error:redirects.source_path_unsafe_encoding
msgid "Source path contains invalid percent-encoding or disallowed ASCII escapes."
msgstr "Đường dẫn nguồn chứa mã hóa phần trăm không hợp lệ hoặc ký tự ASCII bị cấm."

#: server:error:redirects.empty_target_url
msgid "Target URL must not be empty."
msgstr "URL đích không được để trống."

#: server:error:redirects.target_url_too_long
msgid "Target URL exceeds the 2048-byte limit."
msgstr "URL đích vượt quá giới hạn 2048 byte."

#: server:error:redirects.target_url_invalid
msgid "Target URL must be an internal path starting with '/' or a valid http(s):// URL without credentials."
msgstr "URL đích phải là đường dẫn nội bộ bắt đầu bằng '/' hoặc URL http(s):// hợp lệ không chứa thông tin đăng nhập."

#: server:error:redirects.target_url_unsafe_protocol_relative
msgid "Target URL must not start with '//' or '/\\'."
msgstr "URL đích không được bắt đầu bằng '//' hoặc '/\\'."

#: server:error:redirects.self_redirect
msgid "Source path and target URL must not form a self-redirect."
msgstr "Đường dẫn nguồn và URL đích không được trỏ về chính nó."

#: server:error:redirects.invalid_status_code
msgid "Redirect status code must be 301 or 302."
msgstr "Mã trạng thái chuyển hướng chỉ hỗ trợ 301 hoặc 302."

#: server:error:redirects.note_too_long
msgid "Redirect note must not exceed 256 characters."
msgstr "Ghi chú chuyển hướng không được vượt quá 256 ký tự."

#: server:error:redirects.note_control_chars
msgid "Redirect note must not contain control characters."
msgstr "Ghi chú chuyển hướng không được chứa ký tự điều khiển."

#: server:error:redirects.csv_empty
msgid "CSV content contains no valid data rows."
msgstr "Nội dung CSV không có dòng dữ liệu hợp lệ nào."

#: server:error:redirects.csv_too_large
msgid "CSV content exceeds the maximum 2 MiB limit."
msgstr "Nội dung CSV vượt quá giới hạn tối đa 2 MiB."

#: server:error:redirects.csv_too_many_rows
msgid "CSV content exceeds the maximum 5,000 data rows."
msgstr "Nội dung CSV vượt quá giới hạn tối đa 5.000 dòng dữ liệu."

#: server:error:redirects.csv_malformed_quote
msgid "CSV content has malformed quotation marks."
msgstr "Nội dung CSV có dấu ngoặc kép không hợp lệ."

#: server:error:redirects.csv_missing_required_headers
msgid "CSV header must include source_path and target_url columns."
msgstr "Tiêu đề CSV bắt buộc phải có cột source_path và target_url."

#: server:error:redirects.csv_duplicate_mapped_headers
msgid "CSV header maps multiple columns to the same field."
msgstr "Tiêu đề CSV có nhiều cột ánh xạ trùng về cùng một trường."

#: server:error:redirects.csv_invalid_status_value
msgid "CSV status_code value must be 301 or 302."
msgstr "Giá trị status_code trong CSV chỉ chấp nhận 301 hoặc 302."

#: server:error:redirects.csv_invalid_enabled_value
msgid "CSV enabled value must be true/false, 1/0, or yes/no."
msgstr "Giá trị enabled trong CSV chỉ chấp nhận true/false, 1/0 hoặc yes/no."

#: server:error:redirects.csv_invalid_column_count
msgid "CSV row has an invalid column count."
msgstr "Số lượng cột trên dòng CSV không hợp lệ."

#: server:error:redirects.csv_duplicate_in_batch
msgid "Duplicate source path within the same CSV batch."
msgstr "Đường dẫn nguồn bị lặp lại trong cùng tệp CSV."

#: server:error:redirects.conflict_existing_source
msgid "Source path already exists in manual redirects."
msgstr "Đường dẫn nguồn đã tồn tại trong bảng chuyển hướng."

#: server:error:redirects.cycle_or_chain_exceeded
msgid "Rule creates a redirect loop or a chain longer than 3 hops."
msgstr "Quy tắc tạo vòng lặp chuyển hướng hoặc chuỗi dài hơn 3 bước."

#: server:error:redirects.quota_exceeded
msgid "Maximum quota of 20,000 manual redirects has been reached."
msgstr "Đã đạt giới hạn tối đa 20.000 chuyển hướng thủ công."

#: server:error:redirects.csv_import_validation_failed
msgid "CSV import failed: one or more rows are invalid or create a redirect loop."
msgstr "Nhập CSV thất bại: có dòng không hợp lệ hoặc tạo vòng lặp."

#: server:error:redirects.csv_import_conflicts
msgid "CSV import failed: one or more source paths already exist."
msgstr "Nhập CSV thất bại: có đường dẫn nguồn đã tồn tại."

#: server:error:redirects.rule_not_found
msgid "Manual redirect rule not found."
msgstr "Không tìm thấy quy tắc chuyển hướng."

#: server:error:redirects.precondition_failed
msgid "Manual redirect rule was modified concurrently; please reload."
msgstr "Quy tắc chuyển hướng đã bị thay đổi bởi thao tác khác; hãy tải lại."

#: server:error:redirects.not_found_log_not_found
msgid "404 log entry not found."
msgstr "Không tìm thấy mục nhật ký 404."

#: server:error:redirects.invalid_bulk_delete_ids
msgid "Bulk delete IDs must contain 1 to 100 unique positive integers."
msgstr "Danh sách ID cần xóa phải có từ 1 đến 100 số nguyên dương không trùng lặp."

#: server:error:redirects.invalid_clear_days
msgid "older_than_days must be between 1 and 3650 days."
msgstr "Giá trị older_than_days phải nằm trong khoảng 1 đến 3650 ngày."

#: server:error:redirects.invalid_query
msgid "Invalid query parameters for redirects or 404 logs."
msgstr "Tham số truy vấn danh sách chuyển hướng hoặc nhật ký 404 không hợp lệ."

#: server:error:redirects.invalid_json_or_too_large
msgid "Invalid or oversized redirect JSON payload."
msgstr "Dữ liệu JSON chuyển hướng không hợp lệ hoặc vượt quá giới hạn kích thước cho phép."

#: server:error:redirects.csv_http_payload_too_large
msgid "CSV import request payload exceeds the maximum allowed HTTP body size."
msgstr "Nội dung yêu cầu nhập CSV vượt quá giới hạn kích thước HTTP cho phép."

