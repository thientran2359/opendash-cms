msgstr "Mẫu giao diện này phải giữ lại ít nhất một core/content-slot."

#: admin:studio.workspace.requires_slot
msgid "This template requires exactly one core/content-slot."
msgstr "Mẫu giao diện này yêu cầu đúng một core/content-slot."
