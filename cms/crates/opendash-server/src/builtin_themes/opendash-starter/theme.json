{
  "manifest_version": 3,
  "theme_id": "opendash-starter",
  "name": "OpenDash Starter",
  "version": "1.0.0",
  "default_locale": "vi",
  "parts": {
    "header": "header.html",
    "footer": "footer.html",
    "post-card": "template-part/post-card.html",
    "language-switcher": "template-part/language-switcher.html"
  },
  "templates": [
    {
      "kind": "home",
      "file": "home.html"
    },
    {
      "kind": "page",
      "file": "page.html"
    },
    {
      "kind": "single",
      "file": "single.html"
    },
    {
      "kind": "single",
      "file": "single-post.html",
      "content_type": "post"
    },
    {
      "kind": "archive",
      "file": "archive.html"
    },
    {
      "kind": "archive",
      "file": "archive-post.html",
      "content_type": "post"
    },
    {
      "kind": "taxonomy",
      "file": "taxonomy.html"
    },
    {
      "kind": "not_found",
      "file": "404.html"
    },
    {
      "kind": "index",
      "file": "index.html"
    }
  ],
  "page_layouts": [
    {
      "key": "default",
      "label": "Mặc định (Khung chuẩn)",
      "file": "page-layouts/default.html"
    },
    {
      "key": "full_width",
      "label": "Tràn viền (Full Width Builder)",
      "file": "page-layouts/full-width.html"
    },
    {
      "key": "canvas",
      "label": "Landing Page (Ẩn Header & Footer)",
      "file": "page-layouts/canvas.html",
      "chrome": "none"
    }
  ],
  "patterns": [
    {
      "key": "hero_launchpad",
      "title": "Hero SaaS & Thanh chỉ số",
      "category": "hero",
      "description": "Khối mở đầu nổi bật kèm CTA và ba chỉ số.",
      "file": "patterns/hero-launchpad.json"
    },
    {
      "key": "features_bento_grid",
      "title": "Lưới 3 tính năng cốt lõi",
      "category": "features",
      "description": "Bố cục ba cột giới thiệu điểm mạnh.",
      "file": "patterns/features-bento-grid.json"
    },
    {
      "key": "about_story_split",
      "title": "Câu chuyện thương hiệu 2 cột",
      "category": "content",
      "description": "Giới thiệu và trích dẫn khách hàng.",
      "file": "patterns/about-story-split.json"
    },
    {
      "key": "pricing_tiers",
      "title": "Bảng giá 3 gói dịch vụ",
      "category": "pricing",
      "description": "So sánh các gói Starter, Pro và Enterprise.",
      "file": "patterns/pricing-tiers.json"
    },
    {
      "key": "faq_accordion",
      "title": "Câu hỏi thường gặp (FAQ)",
      "category": "faq",
      "description": "Các câu hỏi và phần trả lời có thể thu gọn.",
      "file": "patterns/faq-accordion.json"
    },
    {
      "key": "cta_newsletter_banner",
      "title": "Banner kêu gọi hành động",
      "category": "cta",
      "description": "Mời khách hàng bắt đầu liên hệ.",
      "file": "patterns/cta-newsletter-banner.json"
    }
  ],
  "assets": [
    "assets/style.css"
  ],
  "menus": [
    "primary",
    "footer"
  ],
  "options": [
    {
      "key": "header_badge",
      "label": "Nhãn đầu trang",
      "type": "text",
      "default": "OPENDASH STARTER",
      "public": true,
      "translatable": true
    },
    {
      "key": "header_cta_label",
      "label": "Nhãn nút đầu trang",
      "type": "text",
      "default": "Khám phá ngay",
      "public": true,
      "translatable": true
    },
    {
      "key": "header_cta_url",
      "label": "Đường dẫn nút đầu trang",
      "type": "url",
      "default": "/gioi-thieu",
      "public": true,
      "translatable": true
    },
    {
      "key": "footer_copyright",
      "label": "Bản quyền chân trang",
      "type": "text",
      "default": "Xây dựng trên nền tảng OpenDash CMS — Single-Binary Rust + SQLite & Tailwind CSS v4.",
      "public": true,
      "translatable": true
    },
    {
      "key": "show_tagline",
      "label": "Hiện tagline",
      "type": "boolean",
      "default": true,
      "public": true
    }
  ],
  "sample": {
    "sample_key": "starter_default",
    "pages": [
      {
        "object_key": "home_page",
        "slug": "trang-chu",
        "title": "Trang chủ OpenDash",
        "content_type": "page",
        "values": {
          "body": "<!-- od:core/section {\"id\":\"home-sec\"} -->\n<!-- od:core/banner {\"id\":\"home-banner\"} -->\n<!-- od:core/heading {\"id\":\"home-banner-heading\",\"props\":{\"level\":\"h1\",\"size\":\"3xl\",\"text\":\"Chào mừng đến với OpenDash\"}} /-->\n<!-- od:core/text {\"id\":\"home-banner-body\"} -->\n<p>CMS Rust + SQLite, một binary duy nhất.</p>\n<!-- /od:core/text -->\n<!-- od:core/button {\"id\":\"home-banner-cta\",\"props\":{\"cta\":{\"label\":\"Khám phá OpenDash\",\"new_tab\":false,\"nofollow\":false,\"url\":\"/gioi-thieu\"}}} /-->\n<!-- /od:core/banner -->\n<!-- od:opendash-starter/stats-bar {\"id\":\"home-stats\",\"props\":{\"stat_1_label\":\"Ý tưởng\",\"stat_1_value\":\"100+\",\"stat_2_label\":\"Hiệu suất\",\"stat_2_value\":\"99%\",\"stat_3_label\":\"Đồng hành\",\"stat_3_value\":\"24/7\"}} /-->\n<!-- od:core/row {\"id\":\"home-cards-row\",\"props\":{\"columns\":3,\"layout_mode\":\"equal\"}} -->\n<!-- od:core/column {\"id\":\"home-card-col-1\"} -->\n<!-- od:core/card {\"id\":\"home-card-1\"} -->\n<!-- od:core/heading {\"id\":\"home-card-1-heading\",\"props\":{\"level\":\"h3\",\"size\":\"lg\",\"text\":\"Hiệu năng\"}} /-->\n<!-- od:core/text {\"id\":\"home-card-1-body\"} -->\n<p>Backend Rust mạnh mẽ.</p>\n<!-- /od:core/text -->\n<!-- /od:core/card -->\n<!-- /od:core/column -->\n<!-- od:core/column {\"id\":\"home-card-col-2\"} -->\n<!-- od:core/card {\"id\":\"home-card-2\"} -->\n<!-- od:core/heading {\"id\":\"home-card-2-heading\",\"props\":{\"level\":\"h3\",\"size\":\"lg\",\"text\":\"Dễ dùng\"}} /-->\n<!-- od:core/text {\"id\":\"home-card-2-body\"} -->\n<p>Trình dựng trang trực quan.</p>\n<!-- /od:core/text -->\n<!-- /od:core/card -->\n<!-- /od:core/column -->\n<!-- od:core/column {\"id\":\"home-card-col-3\"} -->\n<!-- od:core/card {\"id\":\"home-card-3\"} -->\n<!-- od:core/heading {\"id\":\"home-card-3-heading\",\"props\":{\"level\":\"h3\",\"size\":\"lg\",\"text\":\"Tin cậy\"}} /-->\n<!-- od:core/text {\"id\":\"home-card-3-body\"} -->\n<p>Dữ liệu SQLite và backup chủ động.</p>\n<!-- /od:core/text -->\n<!-- /od:core/card -->\n<!-- /od:core/column -->\n<!-- /od:core/row -->\n<!-- od:opendash-starter/quote-box {\"id\":\"home-quote\",\"props\":{\"author\":\"OpenDash\",\"quote\":\"Mỗi ý tưởng đều xứng đáng có một không gian trên web.\",\"role\":\"Đội ngũ sản phẩm\"}} /-->\n<!-- od:core/accordion {\"id\":\"home-faq\",\"props\":{\"open_first\":true,\"style\":\"bordered\"}} -->\n<!-- od:core/accordion-item {\"id\":\"home-faq-item-1\",\"props\":{\"open_by_default\":true,\"title\":\"OpenDash phù hợp ai?\"}} -->\n<!-- od:core/text {\"id\":\"home-faq-item-1-body\"} -->\n<p>Nhà sáng tạo, doanh nghiệp và nhóm phát triển.</p>\n<!-- /od:core/text -->\n<!-- /od:core/accordion-item -->\n<!-- /od:core/accordion -->\n<!-- /od:core/section -->"
        }
      },
      {
        "object_key": "about_page",
        "slug": "gioi-thieu",
        "title": "Giới thiệu OpenDash",
        "content_type": "page",
        "values": {
          "body": "<h2>Về OpenDash</h2><p>Chúng tôi giúp bạn xây dựng website bằng Rust, SQLite và Tailwind CSS.</p>"
        }
      },
      {
        "object_key": "contact_page",
        "slug": "lien-he",
        "title": "Liên hệ & Hỗ trợ",
        "content_type": "page",
        "values": {
          "body": "<h2>Liên hệ</h2><p>Hãy kết nối cùng đội ngũ OpenDash để bắt đầu dự án.</p>"
        }
      },
      {
        "object_key": "post_rust_sqlite",
        "slug": "kien-truc-single-binary-rust-sqlite",
        "title": "Kiến trúc Single-Binary Rust + SQLite trong OpenDash",
        "content_type": "post",
        "values": {
          "body": "<p>Rust và SQLite giúp triển khai CMS gọn nhẹ, hiệu năng cao và bảo toàn dữ liệu.</p>"
        }
      },
      {
        "object_key": "post_tailwind_v3",
        "slug": "thiet-ke-giao-dien-voi-tailwind-css-va-theme-v3",
        "title": "Thiết kế giao diện nhanh với Tailwind CSS v4 & Theme v3",
        "content_type": "post",
        "values": {
          "body": "<p>Tailwind CSS v4 và Theme v3 cung cấp trải nghiệm thiết kế đáp ứng nhanh chóng.</p>"
        }
      }
    ],
    "menus": [
      {
        "object_key": "primary_menu",
        "menu_key": "primary",
        "slot_key": "primary",
        "title": "Menu chính",
        "items": [
          {
            "label": "Trang chủ",
            "target_kind": "entry",
            "target_object_key": "home_page"
          },
          {
            "label": "Giới thiệu",
            "target_kind": "entry",
            "target_object_key": "about_page"
          },
          {
            "label": "Bài viết",
            "target_kind": "external",
            "url": "/posts"
          },
          {
            "label": "Liên hệ",
            "target_kind": "entry",
            "target_object_key": "contact_page"
          }
        ]
      },
      {
        "object_key": "footer_menu",
        "menu_key": "footer",
        "slot_key": "footer",
        "title": "Menu chân trang",
        "items": [
          {
            "label": "Trang chủ",
            "target_kind": "entry",
            "target_object_key": "home_page"
          },
          {
            "label": "Giới thiệu",
            "target_kind": "entry",
            "target_object_key": "about_page"
          },
          {
            "label": "Liên hệ",
            "target_kind": "entry",
            "target_object_key": "contact_page"
          }
        ]
      }
    ],
    "settings": [
      {
        "object_key": "opt_badge",
        "option_key": "header_badge",
        "value": "OPENDASH CMS V1"
      },
      {
        "object_key": "opt_cta_label",
        "option_key": "header_cta_label",
        "value": "Tìm hiểu thêm"
      }
    ]
  }
}
