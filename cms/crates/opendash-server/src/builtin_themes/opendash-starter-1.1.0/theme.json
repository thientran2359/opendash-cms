{
  "manifest_version": 3,
  "theme_id": "opendash-starter",
  "name": "OpenDash Starter",
  "version": "1.1.0",
  "default_locale": "vi",
  "parts": {
    "header": "header.html",
    "footer": "footer.html",
    "post-card": "template-part/post-card.html",
    "language-switcher": "template-part/language-switcher.html"
  },
  "templates": [
    {
      "kind": "home",
      "file": "home.html"
    },
    {
      "kind": "page",
      "file": "page.html"
    },
    {
      "kind": "single",
      "file": "single.html"
    },
    {
      "kind": "single",
      "file": "single-post.html",
      "content_type": "post"
    },
    {
      "kind": "archive",
      "file": "archive.html"
    },
    {
      "kind": "archive",
      "file": "archive-post.html",
      "content_type": "post"
    },
    {
      "kind": "taxonomy",
      "file": "taxonomy.html"
    },
    {
      "kind": "not_found",
      "file": "404.html"
    },
    {
      "kind": "index",
      "file": "index.html"
    }
  ],
  "page_layouts": [
    {
      "key": "default",
      "label": "Mặc định (Khung chuẩn)",
      "file": "page-layouts/default.html"
    },
    {
      "key": "full_width",
      "label": "Tràn viền (Full Width Builder)",
      "file": "page-layouts/full-width.html"
    },
    {
      "key": "canvas",
      "label": "Landing Page (Ẩn Header & Footer)",
      "file": "page-layouts/canvas.html"
    }
  ],
  "patterns": [
    {
      "key": "hero_launchpad",
      "title": "Hero SaaS & Thanh chỉ số",
      "category": "hero",
      "description": "Khối mở đầu nổi bật kèm CTA và ba chỉ số.",
      "file": "patterns/hero-launchpad.json"
    },
    {
      "key": "features_bento_grid",
      "title": "Lưới 3 tính năng cốt lõi",
      "category": "features",
      "description": "Bố cục ba cột giới thiệu điểm mạnh.",
      "file": "patterns/features-bento-grid.json"
    },
    {
      "key": "about_story_split",
      "title": "Câu chuyện thương hiệu 2 cột",
      "category": "content",
      "description": "Giới thiệu và trích dẫn khách hàng.",
      "file": "patterns/about-story-split.json"
    },
    {
      "key": "pricing_tiers",
      "title": "Bảng giá 3 gói dịch vụ",
      "category": "pricing",
      "description": "So sánh các gói Starter, Pro và Enterprise.",
      "file": "patterns/pricing-tiers.json"
    },
    {
      "key": "faq_accordion",
      "title": "Câu hỏi thường gặp (FAQ)",
      "category": "faq",
      "description": "Các câu hỏi và phần trả lời có thể thu gọn.",
      "file": "patterns/faq-accordion.json"
    },
    {
      "key": "cta_newsletter_banner",
      "title": "Banner kêu gọi hành động",
      "category": "cta",
      "description": "Mời khách hàng bắt đầu liên hệ.",
      "file": "patterns/cta-newsletter-banner.json"
    }
  ],
  "assets": [
    "assets/style.css"
  ],
  "menus": [
    "primary",
    "footer"
  ],
  "options": [
    {
      "key": "header_badge",
      "label": "Nhãn đầu trang",
      "type": "string",
      "default": "OPENDASH STARTER",
      "public": true,
      "translatable": true
    },
    {
      "key": "header_cta_label",
      "label": "Nhãn nút đầu trang",
      "type": "string",
      "default": "Khám phá ngay",
      "public": true,
      "translatable": true
    },
    {
      "key": "header_cta_url",
      "label": "Đường dẫn nút đầu trang",
      "type": "url",
      "default": "/gioi-thieu",
      "public": true,
      "translatable": true
    },
    {
      "key": "footer_copyright",
      "label": "Bản quyền chân trang",
      "type": "string",
      "default": "Xây dựng trên nền tảng OpenDash CMS — Single-Binary Rust + SQLite & Tailwind CSS v4.",
      "public": true,
      "translatable": true
    },
    {
      "key": "show_tagline",
      "label": "Hiện tagline",
      "type": "boolean",
      "default": true,
      "public": true
    }
  ],
  "sample": {
    "sample_key": "starter_default",
    "pages": [
      {
        "object_key": "home_page",
        "slug": "trang-chu",
        "title": "Trang chủ OpenDash",
        "content_type": "page",
        "values": {
          "body": "<!-- od:section {\"id\":\"home-sec\"} -->\n<!-- od:row {\"id\":\"home-row\"} -->\n<!-- od:column {\"id\":\"home-col\"} -->\n<!-- od:plugin_block {\"id\":\"home-banner\",\"block_id\":\"core/banner\",\"values\":{\"heading\":\"Chào mừng đến với OpenDash\",\"body\":\"<p>CMS Rust + SQLite, một binary duy nhất.</p>\",\"show_cta\":true,\"cta_label\":\"Khám phá OpenDash\",\"cta_url\":\"/gioi-thieu\"}} /-->\n<!-- od:plugin_block {\"id\":\"home-stats\",\"block_id\":\"opendash-starter/stats-bar\",\"values\":{\"stat_1_value\":\"100+\",\"stat_1_label\":\"Ý tưởng\",\"stat_2_value\":\"99%\",\"stat_2_label\":\"Hiệu suất\",\"stat_3_value\":\"24/7\",\"stat_3_label\":\"Đồng hành\"}} /-->\n<!-- od:plugin_block {\"id\":\"home-card-1\",\"block_id\":\"core/card\",\"values\":{\"title\":\"Hiệu năng\",\"body\":\"<p>Backend Rust mạnh mẽ.</p>\"}} /-->\n<!-- od:plugin_block {\"id\":\"home-card-2\",\"block_id\":\"core/card\",\"values\":{\"title\":\"Dễ dùng\",\"body\":\"<p>Trình dựng trang trực quan.</p>\"}} /-->\n<!-- od:plugin_block {\"id\":\"home-card-3\",\"block_id\":\"core/card\",\"values\":{\"title\":\"Tin cậy\",\"body\":\"<p>Dữ liệu SQLite và backup chủ động.</p>\"}} /-->\n<!-- od:plugin_block {\"id\":\"home-quote\",\"block_id\":\"opendash-starter/quote-box\",\"values\":{\"quote\":\"Mỗi ý tưởng đều xứng đáng có một không gian trên web.\",\"author\":\"OpenDash\",\"role\":\"Đội ngũ sản phẩm\"}} /-->\n<!-- od:plugin_block {\"id\":\"home-faq\",\"block_id\":\"core/accordion\",\"values\":{\"style\":\"bordered\",\"open_first\":true,\"items\":[{\"title\":\"OpenDash phù hợp ai?\",\"content\":\"<p>Nhà sáng tạo, doanh nghiệp và nhóm phát triển.</p>\",\"open\":true}]}} /-->\n<!-- /od:column -->\n<!-- /od:row -->\n<!-- /od:section -->"
        }
      },
      {
        "object_key": "about_page",
        "slug": "gioi-thieu",
        "title": "Giới thiệu OpenDash",
        "content_type": "page",
        "values": {
          "body": "<h2>Về OpenDash</h2><p>Chúng tôi giúp bạn xây dựng website bằng Rust, SQLite và Tailwind CSS.</p>"
        }
      },
      {
        "object_key": "contact_page",
        "slug": "lien-he",
        "title": "Liên hệ & Hỗ trợ",
        "content_type": "page",
        "values": {
          "body": "<h2>Liên hệ</h2><p>Hãy kết nối cùng đội ngũ OpenDash để bắt đầu dự án.</p>"
        }
      },
      {
        "object_key": "post_rust_sqlite",
        "slug": "kien-truc-single-binary-rust-sqlite",
        "title": "Kiến trúc Single-Binary Rust + SQLite trong OpenDash",
        "content_type": "post",
        "values": {
          "body": "<p>Rust và SQLite giúp triển khai CMS gọn nhẹ, hiệu năng cao và bảo toàn dữ liệu.</p>"
        }
      },
      {
        "object_key": "post_tailwind_v3",
        "slug": "thiet-ke-giao-dien-voi-tailwind-css-va-theme-v3",
        "title": "Thiết kế giao diện nhanh với Tailwind CSS v4 & Theme v3",
        "content_type": "post",
        "values": {
          "body": "<p>Tailwind CSS v4 và Theme v3 cung cấp trải nghiệm thiết kế đáp ứng nhanh chóng.</p>"
        }
      }
    ],
    "menus": [
      {
        "object_key": "primary_menu",
        "menu_key": "primary",
        "slot_key": "primary",
        "title": "Menu chính",
        "items": [
          {
            "label": "Trang chủ",
            "target_kind": "entry",
            "target_object_key": "home_page"
          },
          {
            "label": "Giới thiệu",
            "target_kind": "entry",
            "target_object_key": "about_page"
          },
          {
            "label": "Bài viết",
            "target_kind": "external",
            "url": "/posts"
          },
          {
            "label": "Liên hệ",
            "target_kind": "entry",
            "target_object_key": "contact_page"
          }
        ]
      },
      {
        "object_key": "footer_menu",
        "menu_key": "footer",
        "slot_key": "footer",
        "title": "Menu chân trang",
        "items": [
          {
            "label": "Trang chủ",
            "target_kind": "entry",
            "target_object_key": "home_page"
          },
          {
            "label": "Giới thiệu",
            "target_kind": "entry",
            "target_object_key": "about_page"
          },
          {
            "label": "Liên hệ",
            "target_kind": "entry",
            "target_object_key": "contact_page"
          }
        ]
      }
    ],
    "settings": [
      {
        "object_key": "opt_badge",
        "option_key": "header_badge",
        "value": "OPENDASH CMS V1"
      },
      {
        "object_key": "opt_cta_label",
        "option_key": "header_cta_label",
        "value": "Tìm hiểu thêm"
      }
    ]
  }
}
