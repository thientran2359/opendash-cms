{
  "schema_version": 1,
  "id": "core/card",
  "title": "Thẻ nội dung",
  "category": "content",
  "icon": "square",
  "render": "render.html",
  "fields": [
    {
      "type": "select",
      "key": "layout",
      "label": "Bố cục",
      "options": [
        { "value": "vertical", "label": "Dọc" },
        { "value": "horizontal", "label": "Ngang" }
      ],
      "default": "vertical"
    },
    {
      "type": "media",
      "key": "image",
      "label": "Ảnh thẻ",
      "media_kind": "image"
    },
    {
      "type": "text",
      "key": "title",
      "label": "Tiêu đề",
      "required": true,
      "default": "Thẻ nội dung"
    },
    {
      "type": "richtext",
      "key": "body",
      "label": "Nội dung"
    },
    {
      "type": "color",
      "key": "bg_color",
      "label": "Màu nền",
      "default": "#ffffff",
      "css_var": "--od-card-bg"
    },
    {
      "type": "boolean",
      "key": "show_cta",
      "label": "Hiện nút CTA",
      "default": false
    },
    {
      "type": "text",
      "key": "cta_label",
      "label": "Nhãn nút",
      "conditions": [[{ "field": "show_cta", "op": "eq", "value": true }]],
      "default": "Xem chi tiết"
    },
    {
      "type": "url",
      "key": "cta_url",
      "label": "Liên kết",
      "conditions": [[{ "field": "show_cta", "op": "eq", "value": true }]],
      "default": "#"
    }
  ]
}
