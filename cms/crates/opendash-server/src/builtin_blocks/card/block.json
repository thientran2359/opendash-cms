{
  "schema_version": 1,
  "id": "core/card",
  "title": "Thẻ nội dung (Card)",
  "category": "content",
  "icon": "square",
  "render": "render.html",
  "supports_children": true,
  "allowed_children": ["*", "!core/section"],
  "default_children": [
    {
      "block_id": "core/heading",
      "props": { "level": "h3", "text": "Tiêu đề thẻ" }
    },
    {
      "block_id": "core/text",
      "props": { "content": "<p>Mô tả ngắn gọn về tính năng hoặc dịch vụ.</p>" }
    }
  ],
  "fields": [
    {
      "type": "media",
      "key": "image",
      "label": "Ảnh thẻ",
      "media_kind": "image"
    },
    {
      "type": "select",
      "key": "media_position",
      "label": "Vị trí ảnh",
      "options": [
        { "value": "top", "label": "Trên" },
        { "value": "left", "label": "Trái" },
        { "value": "right", "label": "Phải" },
        { "value": "none", "label": "Ẩn ảnh" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "key": "media_ratio",
      "label": "Tỉ lệ ảnh",
      "options": [
        { "value": "16_9", "label": "16:9" },
        { "value": "4_3", "label": "4:3" },
        { "value": "1_1", "label": "1:1" },
        { "value": "auto", "label": "Tự động" }
      ],
      "default": "16_9"
    },
    {
      "type": "select",
      "key": "surface_style",
      "label": "Kiểu bề mặt",
      "options": [
        { "value": "flat", "label": "Phẳng" },
        { "value": "bordered", "label": "Có viền" },
        { "value": "elevated", "label": "Đổ bóng" }
      ],
      "default": "bordered"
    },
    {
      "type": "select",
      "key": "tone",
      "label": "Sắc thái",
      "options": [
        { "value": "default", "label": "Mặc định" },
        { "value": "neutral", "label": "Trung tính" },
        { "value": "brand", "label": "Thương hiệu" },
        { "value": "info", "label": "Thông tin" },
        { "value": "success", "label": "Thành công" },
        { "value": "warning", "label": "Chú ý" }
      ],
      "default": "default"
    },
    {
      "type": "icon",
      "key": "icon",
      "label": "Icon (tùy chọn)"
    },
    {
      "type": "color",
      "key": "bg_color",
      "label": "Màu nền tùy chỉnh",
      "default": "#ffffff",
      "css_var": "--od-card-bg"
    },
    {
      "type": "select",
      "key": "radius",
      "label": "Bo góc",
      "options": [
        { "value": "none", "label": "Không" },
        { "value": "md", "label": "Vừa" },
        { "value": "lg", "label": "Lớn" },
        { "value": "xl", "label": "Rất lớn" },
        { "value": "2xl", "label": "Cực lớn" }
      ],
      "default": "xl"
    },
    {
      "type": "spacing",
      "key": "padding",
      "label": "Đệm nội dung",
      "property": "padding",
      "unit": "px",
      "responsive": true,
      "default": { "top": 20, "right": 20, "bottom": 20, "left": 20 }
    },
    {
      "type": "link",
      "key": "card_link",
      "label": "Liên kết toàn thẻ"
    }
  ]
}
