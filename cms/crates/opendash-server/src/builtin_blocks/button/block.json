{
  "schema_version": 1,
  "id": "core/button",
  "title": "Nút bấm (Button)",
  "category": "content",
  "icon": "external-link",
  "render": "native",
  "fields": [
    {
      "type": "link",
      "key": "cta",
      "label": "Liên kết & Nhãn nút",
      "required": true,
      "default": {
        "url": "/lien-he",
        "label": "Xem thêm",
        "new_tab": false,
        "nofollow": false
      }
    },
    {
      "type": "select",
      "key": "variant",
      "label": "Kiểu nút",
      "options": [
        { "value": "primary", "label": "Chính (Primary)" },
        { "value": "secondary", "label": "Phụ (Secondary)" },
        { "value": "outline", "label": "Viền (Outline)" },
        { "value": "ghost", "label": "Tối giản (Ghost)" }
      ],
      "default": "primary"
    },
    {
      "type": "radio_buttons",
      "key": "size",
      "label": "Kích thước",
      "options": [
        { "value": "sm", "label": "Nhỏ" },
        { "value": "md", "label": "Vừa" },
        { "value": "lg", "label": "Lớn" }
      ],
      "default": "md"
    },
    {
      "type": "icon",
      "key": "icon",
      "label": "Icon (tùy chọn)"
    },
    {
      "type": "radio_buttons",
      "key": "icon_pos",
      "label": "Vị trí Icon",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left"
    },
    {
      "type": "boolean",
      "key": "full_width",
      "label": "Trải rộng 100%",
      "default": false
    }
  ]
}
