{
  "schema_version": 1,
  "id": "core/breadcrumbs",
  "title": "Đường dẫn (Breadcrumbs)",
  "category": "template",
  "icon": "chevron-right",
  "render": "native",
  "allowed_contexts": ["template", "part"],
  "fields": [
    {
      "type": "radio_buttons",
      "key": "separator",
      "label": "Dấu phân cách",
      "options": [
        { "value": "chevron", "label": "Mũi tên (>)" },
        { "value": "slash", "label": "Gạch chéo (/)" },
        { "value": "dot", "label": "Chấm tròn (•)" }
      ],
      "default": "chevron"
    },
    {
      "type": "boolean",
      "key": "show_home_icon",
      "label": "Hiện icon Trang chủ",
      "default": false
    },
    {
      "type": "boolean",
      "key": "hide_on_home",
      "label": "Ẩn ở Trang chủ",
      "default": true
    },
    {
      "type": "radio_buttons",
      "key": "align",
      "label": "Căn lề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left",
      "responsive": true
    },
    {
      "type": "color",
      "key": "color",
      "label": "Màu chữ",
      "css_var": "--od-bc-color"
    }
  ]
}
