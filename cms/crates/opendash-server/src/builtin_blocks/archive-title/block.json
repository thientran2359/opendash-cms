{
  "schema_version": 1,
  "id": "core/archive-title",
  "title": "Tiêu đề Lưu trữ (Archive Title)",
  "category": "template",
  "icon": "folder",
  "render": "native",
  "allowed_contexts": ["archive", "taxonomy", "index"],
  "fields": [
    {
      "type": "select",
      "key": "tag",
      "label": "Thẻ tiêu đề",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "boolean",
      "key": "show_prefix",
      "label": "Hiển thị tên phân loại tiền tố",
      "default": false
    },
    {
      "type": "boolean",
      "key": "show_total_count",
      "label": "Hiển thị tổng số bài",
      "default": false
    },
    {
      "type": "select",
      "key": "size",
      "label": "Cỡ chữ",
      "options": [
        { "value": "xl", "label": "XL" },
        { "value": "2xl", "label": "2XL" },
        { "value": "3xl", "label": "3XL" },
        { "value": "4xl", "label": "4XL" }
      ],
      "default": "3xl",
      "responsive": true
    },
    {
      "type": "radio_buttons",
      "key": "align",
      "label": "Căn lề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left",
      "responsive": true
    },
    {
      "type": "color",
      "key": "color",
      "label": "Màu chữ",
      "css_var": "--od-at-color"
    }
  ]
}
