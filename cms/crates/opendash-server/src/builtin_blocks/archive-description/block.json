{
  "schema_version": 1,
  "id": "core/archive-description",
  "title": "Mô tả Lưu trữ (Archive Description)",
  "category": "template",
  "icon": "info",
  "render": "native",
  "allowed_contexts": ["archive", "taxonomy"],
  "fields": [
    {
      "type": "select",
      "key": "font_size",
      "label": "Cỡ chữ",
      "options": [
        { "value": "sm", "label": "Nhỏ" },
        { "value": "base", "label": "Chuẩn" },
        { "value": "lg", "label": "Lớn" }
      ],
      "default": "base",
      "responsive": true
    },
    {
      "type": "radio_buttons",
      "key": "align",
      "label": "Căn lề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left",
      "responsive": true
    },
    {
      "type": "color",
      "key": "color",
      "label": "Màu chữ",
      "css_var": "--od-ad-color"
    },
    {
      "type": "boolean",
      "key": "hide_if_empty",
      "label": "Ẩn khi rỗng",
      "default": true
    }
  ]
}
