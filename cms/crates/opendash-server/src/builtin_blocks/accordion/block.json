{
  "schema_version": 1,
  "id": "core/accordion",
  "title": "Accordion / FAQ",
  "category": "interactive",
  "icon": "chevrons-up-down",
  "render": "render.html",
  "supports_children": true,
  "allowed_children": ["core/accordion-item"],
  "default_children": [
    {
      "block_id": "core/accordion-item",
      "props": { "title": "Câu hỏi 1", "open_by_default": true },
      "children": [
        {
          "block_id": "core/text",
          "props": { "content": "<p>Nội dung trả lời chi tiết cho mục thứ nhất.</p>" }
        }
      ]
    },
    {
      "block_id": "core/accordion-item",
      "props": { "title": "Câu hỏi 2", "open_by_default": false },
      "children": [
        {
          "block_id": "core/text",
          "props": { "content": "<p>Nội dung trả lời chi tiết cho mục thứ hai.</p>" }
        }
      ]
    }
  ],
  "fields": [
    {
      "type": "select",
      "key": "style",
      "label": "Kiểu hiển thị",
      "options": [
        { "value": "bordered", "label": "Có viền" },
        { "value": "minimal", "label": "Tối giản" },
        { "value": "separated", "label": "Tách khối" }
      ],
      "default": "bordered"
    },
    {
      "type": "boolean",
      "key": "allow_multiple",
      "label": "Cho phép mở nhiều mục",
      "default": false
    },
    {
      "type": "boolean",
      "key": "open_first",
      "label": "Mở sẵn mục đầu",
      "default": true
    }
  ]
}
