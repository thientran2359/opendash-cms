{
  "schema_version": 1,
  "id": "core/entry-title",
  "title": "Tiêu đề bài (Entry Title)",
  "category": "template",
  "icon": "file-text",
  "render": "native",
  "allowed_contexts": ["single", "single_custom", "singular", "page", "page_layout", "index", "loop_item"],
  "fields": [
    {
      "type": "select",
      "key": "tag",
      "label": "Thẻ tiêu đề",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "key": "size",
      "label": "Cỡ chữ",
      "options": [
        { "value": "sm", "label": "SM" },
        { "value": "base", "label": "Base" },
        { "value": "lg", "label": "LG" },
        { "value": "xl", "label": "XL" },
        { "value": "2xl", "label": "2XL" },
        { "value": "3xl", "label": "3XL" },
        { "value": "4xl", "label": "4XL" }
      ],
      "default": "3xl",
      "responsive": true
    },
    {
      "type": "radio_buttons",
      "key": "align",
      "label": "Căn lề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left",
      "responsive": true
    },
    {
      "type": "color",
      "key": "color",
      "label": "Màu chữ",
      "css_var": "--od-et-color"
    },
    {
      "type": "boolean",
      "key": "link_to_entry",
      "label": "Liên kết tới bài viết",
      "default": false
    },
    {
      "type": "select",
      "key": "max_lines",
      "label": "Giới hạn số dòng",
      "options": [
        { "value": "none", "label": "Không giới hạn" },
        { "value": "1", "label": "1 dòng" },
        { "value": "2", "label": "2 dòng" },
        { "value": "3", "label": "3 dòng" }
      ],
      "default": "none"
    }
  ]
}
