{
  "schema_version": 1,
  "id": "core/site-brand",
  "title": "Thương hiệu & Logo (Site Brand)",
  "category": "template",
  "icon": "sparkles",
  "render": "native",
  "allowed_contexts": ["template", "part"],
  "fields": [
    {
      "type": "radio_buttons",
      "key": "display_mode",
      "label": "Chế độ hiển thị",
      "options": [
        { "value": "logo_only", "label": "Chỉ Logo" },
        { "value": "title_only", "label": "Chỉ Tên" },
        { "value": "logo_and_title", "label": "Logo + Tên" },
        { "value": "title_and_tagline", "label": "Tên + Khẩu hiệu" }
      ],
      "default": "logo_and_title"
    },
    {
      "type": "range",
      "key": "logo_height",
      "label": "Chiều cao Logo",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 36,
      "unit": "px",
      "responsive": true,
      "css_var": "--od-brand-h"
    },
    {
      "type": "select",
      "key": "title_tag",
      "label": "Thẻ tiêu đề",
      "options": [
        { "value": "span", "label": "span" },
        { "value": "p", "label": "p" },
        { "value": "h1", "label": "h1" }
      ],
      "default": "span"
    },
    {
      "type": "boolean",
      "key": "link_home",
      "label": "Liên kết về Trang chủ",
      "default": true
    },
    {
      "type": "radio_buttons",
      "key": "align",
      "label": "Căn lề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left",
      "responsive": true
    },
    {
      "type": "color",
      "key": "color",
      "label": "Màu chữ",
      "css_var": "--od-brand-color"
    }
  ]
}
