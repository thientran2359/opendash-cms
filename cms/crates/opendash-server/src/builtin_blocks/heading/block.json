{
  "schema_version": 1,
  "id": "core/heading",
  "title": "Tiêu đề (Heading)",
  "category": "content",
  "icon": "heading",
  "render": "native",
  "fields": [
    {
      "type": "select",
      "key": "level",
      "label": "Thẻ HTML",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "key": "text",
      "label": "Nội dung tiêu đề",
      "required": true,
      "max_chars": 512,
      "default": "Tiêu đề"
    },
    {
      "type": "select",
      "key": "size",
      "label": "Cỡ chữ",
      "options": [
        { "value": "xs", "label": "XS" },
        { "value": "sm", "label": "SM" },
        { "value": "md", "label": "MD" },
        { "value": "lg", "label": "LG" },
        { "value": "xl", "label": "XL" },
        { "value": "2xl", "label": "2XL" },
        { "value": "3xl", "label": "3XL" },
        { "value": "4xl", "label": "4XL" }
      ],
      "default": "2xl",
      "responsive": true
    },
    {
      "type": "radio_buttons",
      "key": "align",
      "label": "Căn chữ",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" },
        { "value": "right", "label": "Phải" }
      ],
      "default": "left",
      "responsive": true
    },
    {
      "type": "color",
      "key": "color",
      "label": "Màu chữ",
      "css_var": "--od-heading-color"
    },
    {
      "type": "select",
      "key": "decoration",
      "label": "Trang trí",
      "options": [
        { "value": "none", "label": "Không" },
        { "value": "underline", "label": "Gạch chân" },
        { "value": "line_side", "label": "Đường kẻ bên" }
      ],
      "default": "none"
    },
    {
      "type": "link",
      "key": "link",
      "label": "Liên kết (tùy chọn)"
    }
  ]
}
