{
  "manifest_version": 3,
  "theme_id": "review-theme",
  "name": "Admin Review Theme",
  "version": "1.0.0",
  "templates": [
    {
      "kind": "single",
      "file": "single.html"
    }
  ],
  "admin_extensions": {
    "schema_version": 1,
    "columns": [
      {
        "local_key": "theme_body",
        "label": "Theme badge",
        "type_keys": ["post"],
        "field_key": "body",
        "format": "badge",
        "order": 10
      },
      {
        "local_key": "same_origin_link",
        "label": "Theme link",
        "type_keys": ["post"],
        "field_key": "body",
        "format": "link",
        "order": 15
      }
    ]
  },
  "declarations": {
    "field_groups": [
      {
        "local_key": "theme_notes",
        "title": "Theme Notes",
        "location": [
          [
            { "param": "taxonomy_term", "op": "eq", "value": "category" },
            { "param": "user_role", "op": "eq", "value": "admin" }
          ]
        ],
        "presentation": { "region": "main_bottom", "order": 10 },
        "fields": [
          {
            "key": "caption",
            "label": "Caption",
            "type": "textarea",
            "required": false,
            "acl": { "min_view_role": "admin", "min_edit_role": "admin", "public_exposure": "private" }
          }
        ]
      }
    ]
  }
}
