{
  "id": "rust-seo-plugin",
  "version": "0.1.0",
  "api_version": 1,
  "manifest_schema": 3,
  "min_host_version": "0.1.0",
  "name": "Rust SEO & View Projection Example",
  "description": "Plugin mẫu minh họa Rust Guest SDK v1.1, filters seo/head + entry/view và secret webhook",
  "entrypoint": "plugin.wasm",
  "permissions": {
    "sqlite": ["kv_read", "kv_write"],
    "content_read": ["*"],
    "plugin_settings_read": true,
    "plugin_secrets_read": ["webhook_token"],
    "network": [
      {
        "scheme": "https",
        "host": "hooks.example.com",
        "port": 443,
        "methods": ["POST"],
        "path_prefix": "/seo-ping"
      }
    ]
  },
  "hooks": ["content/after_publish"],
  "filters": ["filter:seo/head", "filter:entry/view"],
  "settings_schema": [
    {
      "key": "brand_name",
      "label": "Tên thương hiệu SEO",
      "type": "text",
      "default": "OpenDash"
    },
    {
      "key": "default_badge",
      "label": "Nhãn hiển thị mặc định",
      "type": "text",
      "default": "Mới"
    },
    {
      "key": "webhook_token",
      "label": "Webhook Bearer Token",
      "type": "secret",
      "default": null
    }
  ]
}
