# Retired handoff runtime (do not recreate as an active queue)
/.agents/sync/

# Project-agent drafts may be Git-tracked; runtime state and credentials must not.
/.agents/**/runtime/
/.agents/**/cache/
/.agents/**/logs/
/.agents/**/secrets/
/.agents/**/credentials/
/.agents/**/tokens/
/.agents/**/state.lock
/.agents/**/state.json
/.agents/**/session*.json
/.agents/**/*.sqlite
/.agents/**/*.sqlite-*
/.agents/**/*.db
/.agents/**/*.log
/.agents/**/*.pem
/.agents/**/*.key
/.agents/**/credentials*.json
/.agents/**/token*.json

# Rust and frontend build outputs
/target/
/cms/target/
/cms/admin/node_modules/
/cms/admin/dist/
/cms/admin/coverage/
/cms/admin/.vite/
/node_modules/
/coverage/

# Local website data and runtime artifacts
/database/*
!/database/README.md
/runtime/
/backups/

# Installed website theme/plugin packages and uploaded media. Keep their
# documentation visible in Git; avoid silently committing site-specific data.
/themes/*
!/themes/README.md
/plugins/*
!/plugins/README.md
/uploads/*
!/uploads/README.md

# Secrets and local overrides
.env
.env.*
!.env.example
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Python smoke test cache
__pycache__/
*.py[cod]
.pytest_cache/

/cms/examples/plugins/sample-plugin/node_modules/
/cms/examples/plugins/sample-plugin/build/
